  "per_test_timeout_s": 60.0,
  "chunk_launch_limit_s": 115.0,
  "chunk_hard_limit_s": 145.0,
  "poll_s": 0.2,
  "timing_passes_B": 2,
  "timing_passes_P": 1
 },
 "estimator_common": {
  "source": "P pass 1 (P's own slice files)",
  "match": "normalized node id (identical to Phase D)",
  "duration": "setup + call + teardown seconds as reported by pytest; timeouts = per_test_timeout_s",
  "speed_band": [
   0.8,
   1.25
  ],
  "speed_rule": "k = calibration time recorded by B's collect-only call / median calibration time over P's run calls; if k outside the band, all estimates and budgets are multiplied by k (identical to Phase D)"
 },
 "estimators": {
  "primary": {
   "name": "F3_mean_newfile_quantile (q=0.99)",
   "description": "seen test: its P duration; unseen test in a file with >= 3 seen tests: the mean P duration of that file's seen tests; unseen test in a file with < 3 seen tests (a whole new file): the 99th percentile (type 7) of all P durations",
   "spec": {
    "in_file": {
     "stat": "mean"
    },
    "min_seen": 3,
    "new_file": {
     "over": "tests",
     "q": 0.99,
     "stat": "quantile"
    }
   },
   "chosen_by": "phase_e/dev/select_estimator.py (LOPO on Phase D data, pre-stated criterion)"
  },
  "secondary": {
   "name": "F10_quantile_newfile_p99 (q_in=0.9)",
   "description": "as primary, but an unseen test in a known file is priced at the 90th percentile of that file's seen P durations",
   "spec": {
    "in_file": {
     "q": 0.9,
     "stat": "quantile"
    },
    "min_seen": 3,
    "new_file": {
     "over": "tests",
     "q": 0.99,
     "stat": "quantile"
    }
   },
   "role": "registered secondary: same rules, reported, no confirmatory claim"
  },
  "comparator_phase_d_registered": {
   "name": "Phase D registered rule (file median, global median)",
   "spec": {
    "min_seen": 3,
    "in_file": {
     "stat": "median"
    },
    "new_file": {
     "stat": "median",
     "over": "tests"
    }
   },
   "role": "exploratory comparator"
  }
 },
 "real_cost": {
  "definition": "mean over the B timing passes with a record of setup+call+teardown seconds; timeout = per_test_timeout_s",
  "missing": "a suite test without any B record is charged its estimate and counted (n_imputed_real, a deviation)"
 },
